{
    "openapi": "3.0.3",
    "info": {
        "title": "versioniq",
        "version": "0.0.1",
        "description": "Install any earlier or newer version of already installed Nextcloud apps\n\nEvery path is served under `/api/v1/`, the version this document describes. The unversioned `/api/` paths keep working, are deprecated, and name their `/api/v1/` successor in a `Link` header next to a `Deprecation` header.\n\nEvery path is served under `/api/v1/`, the version this document describes. The unversioned `/api/` paths keep working, are deprecated, and name their `/api/v1/` successor in a `Link` header next to a `Deprecation` header.",
        "license": {
            "name": "EUPL-1.2"
        },
        "contact": {
            "name": "Conduction B.V.",
            "email": "info@conduction.nl",
            "url": "https://conduction.nl"
        }
    },
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            },
            "bearer_auth": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "OcsMeta": {
                "type": "object",
                "required": [
                    "status",
                    "statuscode"
                ],
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "statuscode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "totalitems": {
                        "type": "string"
                    },
                    "itemsperpage": {
                        "type": "string"
                    }
                }
            },
            "Problem": {
                "type": "object",
                "description": "RFC 9457 problem details. Members of the original error body are kept beside these.",
                "required": [
                    "type",
                    "title",
                    "status"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "format": "uri-reference",
                        "example": "about:blank"
                    },
                    "title": {
                        "type": "string",
                        "example": "Not Found"
                    },
                    "status": {
                        "type": "integer",
                        "minimum": 400,
                        "maximum": 599,
                        "example": 404
                    },
                    "detail": {
                        "type": "string"
                    }
                },
                "additionalProperties": true
            }
        },
        "headers": {
            "API-Version": {
                "description": "The version of the API that answered, which is the installed app version.",
                "schema": {
                    "type": "string",
                    "example": "1.0.0"
                }
            }
        }
    },
    "paths": {
        "/openapi.json": {
            "get": {
                "operationId": "open_api-show",
                "summary": "The OpenAPI document of this API",
                "description": "Returns this document. It needs no authentication and can be read from any origin.",
                "tags": [
                    "open_api"
                ],
                "security": [],
                "responses": {
                    "200": {
                        "description": "The OpenAPI document.",
                        "headers": {
                            "access-control-allow-origin": {
                                "description": "Always `*`.",
                                "schema": {
                                    "type": "string",
                                    "enum": [
                                        "*"
                                    ]
                                }
                            },
                            "API-Version": {
                                "$ref": "#/components/headers/API-Version"
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The document is not installed.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "open_api",
            "description": "The OpenAPI document that describes this API"
        }
    ],
    "servers": [
        {
            "url": "https://{host}/ocs/v2.php/apps/versioniq/api/v1",
            "description": "The versioniq API, version 1, on a Nextcloud instance.",
            "variables": {
                "host": {
                    "default": "localhost",
                    "description": "The host name of the Nextcloud instance."
                }
            }
        }
    ]
}
