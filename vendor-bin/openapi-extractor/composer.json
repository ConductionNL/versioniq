{
	"require-dev": {
		"cweagans/composer-patches": "^2.0",
		"nextcloud/openapi-extractor": "v1.9.1"
	},
	"config": {
		"allow-plugins": {
			"cweagans/composer-patches": true
		},
		"platform": {
			"php": "8.1"
		}
	},
	"extra": {
		"patches": {
			"nextcloud/openapi-extractor": {
				"Allow EUPL-1.1 / EUPL-1.2 as SPDX identifiers (upstream allow-list is incomplete)": "patches/0001-allow-eupl-spdx-identifiers.patch"
			}
		}
	}
}
