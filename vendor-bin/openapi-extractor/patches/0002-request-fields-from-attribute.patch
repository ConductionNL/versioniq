+
+	/**
+	 * The request fields a method reads through a class named by
+	 * #[RequestFieldsFrom(Fields::class)]: each public property becomes a
+	 * parameter with the property's type and default, documented by its @var.
+	 *
+	 * @return list<array{0: Param, 1: ParamTagValueNode}>
+	 */
+	private static function requestFields(string $context, ClassMethod $method): array {
+		global $classResolver, $phpDocParser, $lexer;
+
+		$fields = [];
+		foreach ($method->attrGroups as $attrGroup) {
+			foreach ($attrGroup->attrs as $attr) {
+				if ($attr->name->getLast() !== 'RequestFieldsFrom') {
+					continue;
+				}
+				$class = $attr->args[0]->value ?? null;
+				if (!$class instanceof ClassConstFetch || !$class->class instanceof Name) {
+					Logger::panic($context, 'RequestFieldsFrom needs a Fields::class argument');
+				}
+				$node = $classResolver->resolve($class->class->toString());
+				if ($node === null) {
+					Logger::panic($context, 'Unable to find the request fields class ' . $class->class->toString());
+				}
+				foreach ($node->getProperties() as $property) {
+					if (!$property->isPublic() || $property->isStatic()) {
+						continue;
+					}
+					$doc = $property->getDocComment()?->getText();
+					$varTags = $doc === null ? [] : $phpDocParser->parse(new TokenIterator($lexer->tokenize($doc)))->getVarTagValues();
+					foreach ($property->props as $prop) {
+						$name = $prop->name->toString();
+						if ($varTags === []) {
+							Logger::panic($context, 'Missing @var for request field ' . $name);
+						}
+						$fields[] = [
+							new Param(new Variable($name), $prop->default, $property->type),
+							new ParamTagValueNode($varTags[0]->type, false, '$' . $name, $varTags[0]->description, false),
+						];
+					}
+				}
+			}
+		}
+
+		return $fields;
+	}
 }
