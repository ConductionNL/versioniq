{
  "name": "versioniq",
  "version": "1.0.0",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --mode development build",
    "lint": "eslint src tests scripts",
    "stylelint": "stylelint \"src/**/*.{vue,scss,css}\"",
    "watch": "vite --mode development build --watch",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "l10n:build": "node scripts/build-l10n-js.cjs",
    "check:l10n-js": "node scripts/build-l10n-js.cjs --check"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/vue": "^9.11.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/vite-config": "^3.0.0-beta.1",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.3.0"
  },
  "engines": {
    "node": "^22.14 || ^24 || >=26",
    "npm": "^11.3.0"
  }
}
